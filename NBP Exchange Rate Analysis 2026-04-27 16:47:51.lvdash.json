{
  "datasets": [
    {
      "name": "c10ceb8f",
      "displayName": "nbp_exchange_rates_silver",
      "config": {
        "version": "1.1",
        "source": "workspace.silver.nbp_exchange_rates_silver",
        "dimensions": [
          {
            "name": "currency_code",
            "expr": "source.currency_code",
            "displayName": "Currency Code"
          },
          {
            "name": "effectiveDate",
            "expr": "source.effectiveDate",
            "displayName": "Effective Date"
          },
          {
            "name": "mid",
            "expr": "source.mid",
            "displayName": "Mid"
          },
          {
            "name": "processing_timestamp",
            "expr": "source.processing_timestamp",
            "displayName": "Processing Timestamp"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "biggest_appreciation",
      "displayName": "Biggest One-Day Appreciation (Growth)",
      "queryLines": [
        "WITH daily_changes AS (\n",
        "  SELECT\n",
        "    currency_code,\n",
        "    effectiveDate,\n",
        "    mid,\n",
        "    LAG(mid) OVER (PARTITION BY currency_code ORDER BY effectiveDate) as prev_mid,\n",
        "    mid - LAG(mid) OVER (PARTITION BY currency_code ORDER BY effectiveDate) as daily_change\n",
        "  FROM\n",
        "    workspace.silver.nbp_exchange_rates_silver\n",
        "),\n",
        "ranked_changes AS (\n",
        "  SELECT\n",
        "    currency_code,\n",
        "    effectiveDate,\n",
        "    mid,\n",
        "    prev_mid,\n",
        "    daily_change,\n",
        "    ROW_NUMBER() OVER (PARTITION BY currency_code ORDER BY daily_change DESC) as rank\n",
        "  FROM\n",
        "    daily_changes\n",
        "  WHERE\n",
        "    daily_change IS NOT NULL\n",
        ")\n",
        "SELECT\n",
        "  currency_code as `Currency`,\n",
        "  effectiveDate as `Date`,\n",
        "  prev_mid as `Previous Rate`,\n",
        "  mid as `New Rate`,\n",
        "  daily_change as `Change (Appreciation)`\n",
        "FROM\n",
        "  ranked_changes\n",
        "WHERE\n",
        "  rank = 1\n",
        "ORDER BY\n",
        "  currency_code"
      ]
    },
    {
      "name": "biggest_depreciation",
      "displayName": "Biggest One-Day Depreciation (Fall)",
      "queryLines": [
        "WITH daily_changes AS (\n",
        "  SELECT\n",
        "    currency_code,\n",
        "    effectiveDate,\n",
        "    mid,\n",
        "    LAG(mid) OVER (PARTITION BY currency_code ORDER BY effectiveDate) as prev_mid,\n",
        "    mid - LAG(mid) OVER (PARTITION BY currency_code ORDER BY effectiveDate) as daily_change\n",
        "  FROM\n",
        "    workspace.silver.nbp_exchange_rates_silver\n",
        "),\n",
        "ranked_changes AS (\n",
        "  SELECT\n",
        "    currency_code,\n",
        "    effectiveDate,\n",
        "    mid,\n",
        "    prev_mid,\n",
        "    daily_change,\n",
        "    ROW_NUMBER() OVER (PARTITION BY currency_code ORDER BY daily_change ASC) as rank\n",
        "  FROM\n",
        "    daily_changes\n",
        "  WHERE\n",
        "    daily_change IS NOT NULL\n",
        ")\n",
        "SELECT\n",
        "  currency_code as `Currency`,\n",
        "  effectiveDate as `Date`,\n",
        "  prev_mid as `Previous Rate`,\n",
        "  mid as `New Rate`,\n",
        "  daily_change as `Change (Depreciation)`\n",
        "FROM\n",
        "  ranked_changes\n",
        "WHERE\n",
        "  rank = 1\n",
        "ORDER BY\n",
        "  currency_code"
      ]
    },
    {
      "name": "highest_rates",
      "displayName": "Highest Historical Rates (Highest Appreciation)",
      "queryLines": [
        "WITH ranked_rates AS (\n",
        "  SELECT\n",
        "    currency_code,\n",
        "    effectiveDate,\n",
        "    mid,\n",
        "    ROW_NUMBER() OVER (PARTITION BY currency_code ORDER BY mid DESC) as rank\n",
        "  FROM\n",
        "    workspace.silver.nbp_exchange_rates_silver\n",
        ")\n",
        "SELECT\n",
        "  currency_code as `Currency`,\n",
        "  effectiveDate as `Date of Highest Rate`,\n",
        "  mid as `Highest Rate (PLN)`\n",
        "FROM\n",
        "  ranked_rates\n",
        "WHERE\n",
        "  rank = 1\n",
        "ORDER BY\n",
        "  currency_code"
      ]
    },
    {
      "name": "lowest_rates",
      "displayName": "Lowest Historical Rates (Highest Depreciation)",
      "queryLines": [
        "WITH ranked_rates AS (\n",
        "  SELECT\n",
        "    currency_code,\n",
        "    effectiveDate,\n",
        "    mid,\n",
        "    ROW_NUMBER() OVER (PARTITION BY currency_code ORDER BY mid ASC) as rank\n",
        "  FROM\n",
        "    workspace.silver.nbp_exchange_rates_silver\n",
        ")\n",
        "SELECT\n",
        "  currency_code as `Currency`,\n",
        "  effectiveDate as `Date of Lowest Rate`,\n",
        "  mid as `Lowest Rate (PLN)`\n",
        "FROM\n",
        "  ranked_rates\n",
        "WHERE\n",
        "  rank = 1\n",
        "ORDER BY\n",
        "  currency_code"
      ]
    }
  ],
